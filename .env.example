# deepai-gateway configuration.
#
# Copy this to `.env` and edit what you need:
#
#     cp .env.example .env
#
# `npm start` loads `.env` automatically when it exists, so nothing has to be
# exported in your shell. Every value here is optional; the defaults are shown.

# ---------------------------------------------------------------- networking

# Listen port.
PORT=8787

# Listen address. `0.0.0.0` is every interface, which is what a gateway needs to
# be reachable from other machines. Set `127.0.0.1` to keep it on this host only.
#
# NOTE: the dashboard has no password of its own - access *is* the DeepAI account
# you sign in with - so binding to 0.0.0.0 makes the panel reachable by anyone who
# can reach the port. Put it behind TLS and, if it is public, behind a reverse
# proxy with its own access control.
HOST=0.0.0.0

# Set to 1 when a proxy terminates TLS in front of this gateway. It makes
# `X-Forwarded-*` headers trusted and the session cookie `Secure`.
# Leave it unset for plain HTTP.
#TRUST_PROXY=1

# ---------------------------------------------------------------- storage

# SQLite database file. It holds every account's DeepAI key in a form that can be
# replayed, so it is created owner-only (0600).
#DATABASE=./data/deepai.db

# Where the fetched OpenRouter price table is cached.
#PRICING_CACHE=./data/pricing.json

# ----------------------------------------------------------------- logging

# Set to 0 to silence the per-request log line.
#LOG_REQUESTS=0

# ------------------------------------------------------------- sign-in

# ------------------------------------------------------------- DeepAI

# The machine identity the gateway presents to DeepAI Code, as a hex string. DeepAI issues
# its daily Credits grant against this, and answers `machine_required` without it.
#
# You should not need to set this. Leave it unset and the gateway works it out: it hashes
# this host's own identifier (the DMI product UUID on Linux, IOPlatformUUID on macOS, the
# SMBIOS UUID or MachineGuid on Windows), sending only the SHA-256 and never the identifier.
# When the host has none - a container usually has neither `/sys/class/dmi/id/product_uuid`
# nor `/etc/machine-id` - the gateway generates one on first start and keeps it in its
# database, so it survives restarts and needs no variable set anywhere.
#
# Set it only to *name* this gateway deliberately, for instance to keep a machine identity
# that DeepAI already knows. One gateway is one machine for every account it serves.
#DEEPAI_MACHINE_ID=

# ------------------------------------------------------------- retention

# Forget accounts nobody has used for this many days. 0 (the default) forgets
# nothing, so this has to be set deliberately. Usage history is kept.
#FORGET_ACCOUNT_AFTER_DAYS=30
