# deepai-gateway configuration.
#
# Copy this to `.env` and edit what you need:
#
#     cp .env.example .env
#
# `npm start` loads `.env` automatically when it exists, so nothing has to be
# exported in your shell. Every value here is optional; the defaults are shown.

# ---------------------------------------------------------------- networking

# Listen port.
PORT=8787

# Listen address. `0.0.0.0` is every interface, which is what a gateway needs to
# be reachable from other machines. Set `127.0.0.1` to keep it on this host only.
#
# NOTE: the dashboard has no password of its own - access *is* the DeepAI account
# you sign in with - so binding to 0.0.0.0 makes the panel reachable by anyone who
# can reach the port. Put it behind TLS and, if it is public, behind a reverse
# proxy with its own access control.
HOST=0.0.0.0

# Set to 1 when a proxy terminates TLS in front of this gateway. It makes
# `X-Forwarded-*` headers trusted and the session cookie `Secure`.
# Leave it unset for plain HTTP.
#TRUST_PROXY=1

# ----------------------------------------------------------------- upstream

# Everything sent to DeepAI goes through one kept-alive connection, so a turn does not
# pay a TCP and TLS handshake before its first byte - about 700 ms of every turn they
# would otherwise cost.
#
# If this gateway has to reach DeepAI through an egress proxy, set it here. The lowercase
# spellings work too, and `NODE_USE_ENV_PROXY=0` ignores the proxy entirely, which is how
# Node's own client is switched off as well.
#HTTPS_PROXY=http://proxy.internal:3128
#HTTP_PROXY=http://proxy.internal:3128
#NODE_USE_ENV_PROXY=0

# ------------------------------------------------------------- limit

# How many live API keys one account may hold. It applies to every account on the
# gateway: when someone reaches it they have to revoke one before creating another.
#
# Lowering it does not remove keys that already exist - it only stops new ones, so a
# deployment that had granted more than the new cap keeps them and simply cannot add.
# An unparsable value falls back to the default, and the cap is bounded so a large
# number cannot become an unbounded one by accident.
#MAX_KEYS=5

# ---------------------------------------------------------------- context

# Optional: the largest amount of prompt, in bytes, this gateway asks DeepAI to read FRESH.
#
# Leave it unset for the normal deployment. Each request then uses its selected model's catalog
# entry: (contextWindow - maxTokens) in the same characters-per-token unit as the usage meter.
# A DeepAI catalog change therefore moves the budget without a redeploy.
#
# Set it only when this deployment has measured a tighter limit on its own endpoint. A value that
# is not a positive whole number is ignored, and the model's catalog window is used instead.
#
# Historical note, not a default: a cold prompt measured on the live endpoint in 2026 arrived
# whole at 195,809 bytes and lost its front at 196,811. That is a property of the endpoint at that
# time and cannot be derived from a model's catalog entry, so it is not baked into the gateway.
# A warm conversation is not measured by its total size: its cached prefix costs a few tokens and
# only the new tail is read. The x-gateway-prompt header says what happened (`trim=`).
#PROMPT_BUDGET_BYTES=

# ---------------------------------------------------------------- storage

# SQLite database file. It holds every account's DeepAI key in a form that can be
# replayed, so it is created owner-only (0600).
#DATABASE=./data/deepai.db

# Where the fetched OpenRouter price table is cached.
#PRICING_CACHE=./data/pricing.json

# ----------------------------------------------------------------- logging

# Set to 0 to silence the per-request log line.
#LOG_REQUESTS=0

# ------------------------------------------------------- diagnostics

# Set to 1 to log which reasoning fields are sent to DeepAI on every completion:
# `thinking`, `reasoning_effort`, `reasoning`. The prompt and the key are never logged.
#
# For a field the provider appears to ignore - a reasoning level that changes nothing -
# this is what tells "we do not send it" apart from "they ignore it", which the answer
# alone cannot.
#LOG_UPSTREAM_REASONING=1

# ------------------------------------------------------------- DeepAI

# The machine identity the gateway presents to DeepAI Code, as a hex string. DeepAI issues
# its daily Credits grant against this, and answers `machine_required` without it.
#
# You should not need to set this. Leave it unset and the gateway works it out: it hashes
# this host's own identifier (the DMI product UUID on Linux, IOPlatformUUID on macOS, the
# SMBIOS UUID or MachineGuid on Windows), sending only the SHA-256 and never the identifier.
# When the host has none - a container usually has neither `/sys/class/dmi/id/product_uuid`
# nor `/etc/machine-id` - the gateway generates one on first start and keeps it in its
# database, so it survives restarts and needs no variable set anywhere.
#
# Set it only to *name* this gateway deliberately, for instance to keep a machine identity
# that DeepAI already knows. One gateway is one machine for every account it serves.
#DEEPAI_MACHINE_ID=

# ------------------------------------------------------------- retention

# Forget accounts nobody has used for this many days. 0 (the default) forgets
# nothing, so this has to be set deliberately. Usage history is kept.
#FORGET_ACCOUNT_AFTER_DAYS=30
