{
  "name": "deepai-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible gateway in front of DeepAI Code, with sign-in, API keys, limits and usage analytics",
  "main": "server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node test/run.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "license": "MIT"
}
